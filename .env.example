# ===== Telegram 应用凭证（在 https://my.telegram.org 申请，见 README 教程）=====
# 你的应用 api_id（纯数字）
TELEGRAM_API_ID=
# 你的应用 api_hash（一串十六进制字符）
TELEGRAM_API_HASH=

# ===== 机器人账号与号主 =====
# 机器人小号的用户名（不带 @）
MY_USERNAME=
# 号主（你大号）的数字 ID，只有这个 ID 能用号主命令
OWNER_ID=

# ===== 默认 AI 接口（OpenAI 兼容格式）=====
# 接口密钥
AI_API_KEY=
# 接口地址，末尾带 /v1，例如 https://api.openai.com/v1 或你的中转地址
AI_API_BASE=https://api.openai.com/v1
# 默认模型名
AI_API_MODEL=gpt-4o-mini

# ===== 显示名时钟 =====
# 时区（IANA 名称），名字时钟与日志按此时区显示
TIMEZONE=Asia/Shanghai
# 显示名前缀，名字会显示成「GPT 13:45」这样
NAME_PREFIX=GPT
# 是否开启名字时钟：true 开启，false 关闭
NAME_CLOCK=true
